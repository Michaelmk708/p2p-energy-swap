{
    "configurations": [
        {
            "name": "PlatformIO",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
                "${HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
                "${HOME}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**",
                "${workspaceFolder}/.pio/libdeps/esp32dev/**"
            ],
            "defines": [
                "ESP32",
                "ARDUINO_ESP32_DEV",
                "ARDUINO=10808"
            ],
            "compilerPath": "${HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
